# ---------------------------------------------------------------------------
# Copie este arquivo para .env.local (uso local) e configure as mesmas
# variáveis no painel do Vercel (Settings > Environment Variables).
# Nenhuma credencial deve ser commitada no repositório.
# ---------------------------------------------------------------------------

# Shopify — Admin API (leitura de pedidos).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_TOKEN=
SHOPIFY_API_VERSION=

# Shopify — app de transferências de estoque (outro app, com os escopos
# read_inventory_transfers, read_locations, read_inventory e read_products).
# Domínio e versão são os do app de pedidos acima.
SHOPIFY_TRANSFERENCIAS_TOKEN=

# Tiny (Olist) — token REAL. Leitura é segura; inclusão de nota cria rascunho
# de verdade no Tiny de produção (ver README, seção "Travas de segurança").
TINY_API_TOKEN=
TINY_API_BASE=

# Supabase — chave service role, usada apenas no servidor (API Routes).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Valor inicial da trava de emissão fiscal, só usado se a linha
# "permitir_emissao" ainda não existir na tabela configuracoes do Supabase.
# Mantenha false: com false, nota.fiscal.emitir nunca é chamado.
PERMITIR_EMISSAO=false
